MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/your_database?retryWrites=true&w=majority&appName=YourApp
DB_NAME=your_database_name

# OpenAI Configuration for AI Job Scraping
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000

# Job Scraping Configuration
JOB_SCRAPING_ENABLED=true
SCRAPING_INTERVAL_HOURS=6
MAX_JOBS_PER_PLATFORM=50
